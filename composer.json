{
  "name": "wavevision/cron-generator",
  "type": "library",
  "license": "MIT",
  "description": "Nette DI Extension for generating cron files",
  "config": {
    "platform": {
      "php": "8.5"
    },
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  },
  "autoload": {
    "psr-4": {
      "Wavevision\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wavevision\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Jakub Filla",
      "email": "jakub.filla@wavevision.com"
    }
  ],
  "repositories": [
    {
      "type": "vcs",
      "url": "git@github.com:SimplikoCZ/wavevision-coding-standard.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "git@github.com:SimplikoCZ/wavevision-nette-tests.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "https://github.com/SimplikoCZ/wavevision-utils.git"
    }
  ],
  "require": {
    "php": "^8.1",
    "hollodotme/crontab-validator": "^2.0",
    "nette/di": "^3.2"
  },
  "require-dev": {
    "wavevision/coding-standard": "^7.0",
    "wavevision/nette-tests": "^4.0"
  }
}
